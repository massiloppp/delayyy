name: Build Windows VST3
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - run: cmake -B build -G "Visual Studio 17 2022" -A x64
      - run: cmake --build build --config Release --target ClassicDelay_VST3
      - uses: actions/upload-artifact@v4
        with:
          name: ClassicDelay-VST3-Windows
          path: build/ClassicDelay_artefacts/Release/VST3/Classic Delay.vst3
